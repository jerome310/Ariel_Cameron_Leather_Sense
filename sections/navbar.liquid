<style>
    /* ===== Promo bar ===== */
    .promo-bar {
        padding: 0.85rem 2.5rem;
        background: #1A1815;
    }

    @media (min-width: 768px) {
        .promo-bar {
            padding: 0.85rem 0;
        }
    }

    .promo-bar__inner {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.75rem;
    }

    .promo-bar__emoji {
        display: none;
        /* removed for a quieter, more premium tone */
    }

    .promo-bar__text {
        text-align: center;
        font-weight: 400;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        font-size: 0.75rem;
        color: #F2C744;
        text-shadow: none;
        margin: 0;
    }

    /* ===== Header wrapper ===== */
    .site-header {
        display: flex;
        flex-direction: column;
        width: 100%;
        margin: 0 auto;
        padding-top: 1.25rem;
        background: #FBFAF7;
        font-family: Georgia, 'Times New Roman', serif;
    }

    /* ===== Mobile top bar ===== */
    .mobile-topbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0.75rem 1rem;
    }

    @media (min-width: 768px) {
        .mobile-topbar {
            display: none;
        }
    }

    .hamburger-btn {
        background: none;
        border: none;
        color: #1A1A18;
        cursor: pointer;
        padding: 0;
        line-height: 0;
    }

    .hamburger-btn svg {
        width: 22px;
        height: 22px;
    }

    .hamburger-btn .icon-close {
        display: none;
    }

    .hamburger-btn.is-open .icon-open {
        display: none;
    }

    .hamburger-btn.is-open .icon-close {
        display: block;
    }

    .mobile-logo img {
        width: 100px;
        height: 100px;
    }

    .mobile-actions {
        display: flex;
        align-items: center;
        gap: 1.25rem;
        color: #1A1A18;
    }

    .mobile-actions button {
        background: none;
        border: none;
        cursor: pointer;
        color: inherit;
        padding: 0;
    }

    /* ===== Mobile slide-out menu ===== */
    .mobile-menu {
        background: #FBFAF7;
        border-top: 1px solid #E5E1D8;
        max-height: 0;
        overflow: hidden;
        transition: max-height 0.3s ease;
    }

    @media (min-width: 768px) {
        .mobile-menu {
            display: none;
        }
    }

    .mobile-menu.is-open {
        max-height: 800px;
    }

    .mobile-menu__links {
        display: flex;
        flex-direction: column;
        padding: 1.5rem 1rem 0 1rem;
        gap: 0.5rem;
    }

    .mobile-nav-link {
        font-weight: 400;
        letter-spacing: 0.04em;
        color: #1A1A18;
        text-decoration: none;
        display: block;
        padding: 0.5rem 0.75rem;
        border-radius: 0.25rem;
        font-size: 1rem;
    }

    .mobile-nav-link:hover {
        color: #E561A1;
        text-decoration: underline;
        text-underline-offset: 4px;
    }

    .mobile-accordion {
        border-bottom: 1px solid #E5E1D8;
    }

    .mobile-accordion:last-child {
        border-bottom: none;
    }

    .mobile-accordion__toggle {
        width: 100%;
        display: flex;
        align-items: center;
        justify-content: space-between;
        border-radius: 0.25rem;
    }

    .mobile-accordion__title-link {
        flex: 1;
        font-weight: 400;
        color: #1A1A18;
        text-decoration: none;
        padding: 0.75rem;
        font-size: 1rem;
    }

    .mobile-accordion__title-link:hover {
        color: #E561A1;
        text-decoration: underline;
        text-underline-offset: 4px;
    }

    .mobile-accordion__icon-btn {
        background: none;
        border: none;
        cursor: pointer;
        padding: 0.75rem;
        display: flex;
        align-items: center;
    }

    .mobile-accordion__icon {
        width: 12px;
        height: 12px;
        flex-shrink: 0;
        margin-left: 0.5rem;
        transition: transform 0.3s ease-in-out;
    }

    .mobile-accordion__toggle:hover .mobile-accordion__icon {
        transform: rotate(-180deg);
    }

    .mobile-accordion.is-open .mobile-accordion__icon {
        transform: rotate(-180deg);
    }

    .mobile-accordion__panel {
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
        padding: 0 0.75rem 0 1.5rem;
        max-height: 0;
        overflow: hidden;
        transition: max-height 0.3s ease;
    }

    .mobile-accordion.is-open .mobile-accordion__panel {
        max-height: 500px;
        padding-bottom: 0.75rem;
    }

    .mobile-accordion__link {
        font-weight: 400;
        color: #8A8578;
        text-decoration: none;
        display: block;
        padding: 0.625rem 0.75rem;
        border-radius: 0.25rem;
        font-size: 0.875rem;
        transition: background-color 0.15s ease, color 0.15s ease;
    }

    .mobile-accordion__link:hover {
        background: #FFF1D5;
        color: #1A1A18;
        text-decoration: underline;
        text-underline-offset: 4px;
    }

    .mobile-menu__social {
        display: flex;
        padding: 2rem 1.5rem 1.5rem 1.5rem;
        gap: 1rem;
    }

    /* ===== Desktop nav ===== */
    .desktop-nav {
        display: none;
        align-items: center;
        justify-content: space-between;
        width: 100%;
        margin-top: 1rem;
        padding: 0 2rem;
    }

    @media (min-width: 768px) {
        .desktop-nav {
            display: flex;
        }
    }

    .desktop-nav__links {
        flex: 1;
        display: flex;
        gap: 2.25rem;
    }

    .desktop-nav-link {
        font-weight: 400;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: #4A473E;
        text-decoration: none;
        display: block;
        padding: 0.5rem 0;
        font-size: 0.75rem;
    }

    .desktop-nav-link:hover {
        color: #E561A1;
    }

    .nav-item {
        position: relative;
    }

    .nav-item__toggle {
        display: flex;
        align-items: center;
        gap: 0.3rem;
    }

    .nav-item__link {
        text-decoration: none;
        font-weight: 400;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: #4A473E;
        padding: 0.5rem 0;
        font-size: 0.75rem;
    }

    .nav-item__link:hover {
        color: #E561A1;
    }

    .nav-item__icon-btn {
        background: none;
        border: none;
        cursor: pointer;
        padding: 0.5rem 0.25rem;
        display: flex;
        align-items: center;
    }

    .nav-item__icon {
        width: 10px;
        height: 10px;
        flex-shrink: 0;
        transition: transform 0.3s ease-in-out;
    }

    .nav-item:hover .nav-item__icon,
    .nav-item.is-open .nav-item__icon {
        transform: rotate(-180deg);
    }

    .nav-dropdown {
        position: absolute;
        left: 50%;
        top: 100%;
        margin-top: 0.75rem;
        width: max-content;
        min-width: 280px;
        background: #fff;
        border: 1px solid #E5E1D8;
        border-radius: 0.5rem;
        box-shadow: 0 12px 28px rgba(0, 0, 0, 0.1);
        overflow: hidden;
        z-index: 40;
        opacity: 0;
        visibility: hidden;
        transform: translate(calc(-50% + 30px), -4px);
        transition: opacity 0.15s ease, transform 0.15s ease, visibility 0.15s;
    }

    .nav-item:hover .nav-dropdown,
    .nav-item.is-open .nav-dropdown {
        opacity: 1;
        visibility: visible;
        transform: translate(calc(-50% + 30px), 0);
    }

    .nav-dropdown__arrow {
        position: absolute;
        top: -6px;
        left: 50%;
        transform: translateX(-50%) rotate(45deg);
        width: 12px;
        height: 12px;
        background: #fff;
        border-top: 1px solid #E5E1D8;
        border-left: 1px solid #E5E1D8;
    }

    .nav-dropdown__list {
        position: relative;
        padding: 0.5rem 0;
    }

    .nav-dropdown__list a {
        display: block;
        white-space: nowrap;
        padding: 0.85rem 1.75rem;
        font-size: 0.85rem;
        letter-spacing: 0.04em;
        font-weight: 400;
        color: #4A473E;
        text-decoration: none;
        border-bottom: 1px solid #F3F1EA;
        transition: background-color 0.15s ease, color 0.15s ease;
    }

    .nav-dropdown__list a:last-child {
        border-bottom: none;
    }

    .nav-dropdown__list a:hover {
        background: #FFF1D5;
        color: #1A1A18;
    }

    .desktop-logo {
        flex-shrink: 0;
        margin: 0 auto;
    }

    .desktop-logo--default img {
        width: 120px;
        height: auto;
    }

    .desktop-logo--custom img {
        width: 150px;
        height: 150px;
    }

    @media (min-width: 768px) {
        .desktop-logo--default img {
            width: 150px;
        }

        .desktop-logo--custom img {
            width: 170px;
            height: 170px;
        }
    }

    .desktop-actions {
        flex: 1;
        display: flex;
        justify-content: flex-end;
        align-items: center;
        gap: 1.75rem;
    }

    .icon-btn {
        background: none;
        border: none;
        cursor: pointer;
        color: #4A473E;
        white-space: nowrap;
        font-size: 1rem;
        padding: 0;
        display: flex;
        align-items: center;
    }

    .icon-btn:hover {
        color: #2784FE;
    }

    /* ===== Search modals ===== */
    .search-modal {
        display: none;
        position: fixed;
        inset: 0;
        background: rgba(26, 24, 21, 0.6);
        align-items: center;
        justify-content: center;
        z-index: 50;
        opacity: 0;
        transition: opacity 0.25s ease;
    }

    .search-modal.is-open {
        display: flex;
        opacity: 1;
    }

    .search-modal__close {
        position: fixed;
        top: 1.25rem;
        right: 1.5rem;
        z-index: 9999;
        font-size: 1.5rem;
        color: #fff;
        background: transparent;
        border: none;
        cursor: pointer;
    }

    .search-modal__box {
        background: #FBFAF7;
        padding: 1.5rem;
        border-radius: 0.5rem;
        width: 75%;
        position: relative;
    }

    @media (min-width: 768px) {
        .search-modal__box {
            width: 33.333%;
        }
    }

    .search-modal__box input {
        width: 100%;
        padding: 0.65rem 1rem;
        border: 1px solid #D8D4C8;
        border-radius: 0.25rem;
        box-sizing: border-box;
        font-family: Georgia, serif;
        background: #fff;
    }

    .search-modal__box button[type="submit"] {
        margin-top: 0.65rem;
        width: 100%;
        background: #2784FE;
        color: #fff;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        font-size: 0.75rem;
        padding: 0.65rem;
        border: none;
        border-radius: 0.25rem;
        cursor: pointer;
    }

    .search-modal__box button[type="submit"]:hover {
        background: #1a6fd6;
    }
</style>

<div class="promo-bar">
    <div class="promo-bar__inner">
        <p class="promo-bar__text" aria-label="Welcome message">
            New: The Charm + Wallet Collection
        </p>
    </div>
</div>

<div class="site-header" id="site-header">

    <!-- Mobile top bar -->
    <div class="mobile-topbar">
        <button class="hamburger-btn" id="hamburger-btn" type="button" aria-expanded="false"
            aria-controls="mobile-menu">
            <svg class="icon-open" viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-label="Open menu">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
            </svg>
            <svg class="icon-close" viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-label="Close menu">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
            </svg>
        </button>

        <div class="mobile-logo">
            <a href="{{ shop.url }}" title="Homepage">
                {% if section.settings.image == blank %}
                <img src="{{ 'Header_ACL_Logo.png' | asset_url }}" alt="My company logo">
                {% else %}
                <img src="{{ section.settings.image | img_url: 'master' }}" alt="My company logo">
                {% endif %}
            </a>
        </div>

        <!-- Search icon placed before the cart/bag icon, per request -->
        <div class="mobile-actions">
            <button type="button" id="search-open-mobile" aria-label="Open mobile search bar">
                {% render 'icon-search' %}
            </button>
            {% render 'icon-cart' %}
        </div>
    </div>

    <!-- Mobile slide-out menu -->
    <div class="mobile-menu" id="mobile-menu">
        <div class="mobile-menu__links">
            {% if linklists.main-menu.links.size > 0 %}
            {% for link in linklists.main-menu.links %}
            {% if link.links.size > 0 %}
            <div class="mobile-accordion">
                <div class="mobile-accordion__toggle">
                    <a class="mobile-accordion__title-link" href="{{ link.url }}" title="{{ link.title }}">{{ link.title
                        }}</a>
                    <button type="button" class="mobile-accordion__icon-btn" aria-expanded="false"
                        aria-label="Toggle {{ link.title }} submenu">
                        <svg class="mobile-accordion__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                            stroke-width="3" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                        </svg>
                    </button>
                </div>
                <div class="mobile-accordion__panel">
                    {% for childlink in link.links %}
                    <a class="mobile-accordion__link" href="{{ childlink.url }}" title="{{ childlink.title }}">{{
                        childlink.title }}</a>
                    {% endfor %}
                </div>
            </div>
            {% else %}
            <a class="mobile-nav-link" href="{{ link.url }}" title="{{ link.title }}">{{ link.title }}</a>
            {% endif %}
            {% endfor %}
            {% else %}
            <p>No menu links available.</p>
            {% endif %}
        </div>
        <div class="mobile-menu__social">
            {% render 'social-media-twitter' %}
            {% render 'social-media-facebook' %}
            {% render 'social-media-pinterest' %}
            {% render 'social-media-instagram' %}
            {% render 'social-media-tiktok' %}
        </div>
    </div>

    <!-- Desktop nav -->
    <div class="desktop-nav">
        <div class="desktop-nav__links">
            {% if linklists.main-menu.links.size > 0 %}
            {% for link in linklists.main-menu.links %}
            {% if link.links.size > 0 %}
            <div class="nav-item">
                <div class="nav-item__toggle">
                    <a class="nav-item__link" href="{{ link.url }}" title="{{ link.title }}">{{ link.title }}</a>
                    <button type="button" class="nav-item__icon-btn" aria-expanded="false"
                        aria-label="Toggle {{ link.title }} submenu">
                        <svg class="nav-item__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                            stroke-width="3" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                        </svg>
                    </button>
                </div>
                <div class="nav-dropdown">
                    <div class="nav-dropdown__arrow"></div>
                    <div class="nav-dropdown__list">
                        {% for childlink in link.links %}
                        <a href="{{ childlink.url }}" title="{{ childlink.title }}">{{ childlink.title }}</a>
                        {% endfor %}
                    </div>
                </div>
            </div>
            {% else %}
            <a class="desktop-nav-link" href="{{ link.url }}" title="{{ link.title }}">{{ link.title }}</a>
            {% endif %}
            {% endfor %}
            {% endif %}
        </div>

        <div
            class="desktop-logo {% if section.settings.image == blank %}desktop-logo--default{% else %}desktop-logo--custom{% endif %}">
            <a href="{{ shop.url }}" title="Homepage">
                {% if section.settings.image == blank %}
                <img src="{{ 'Header_ACL_Logo.png' | asset_url }}" alt="My company logo">
                {% else %}
                <img src="{{ section.settings.image | img_url: 'master' }}" alt="My company logo">
                {% endif %}
            </a>
        </div>

        <!-- Search icon placed before the cart/bag icon, per request -->
        <div class="desktop-actions">
            <button type="button" class="icon-btn" id="search-open-desktop" aria-label="Open search bar">
                {% render 'icon-search' %}
            </button>
            {% render 'icon-cart' %}
        </div>
    </div>

    <!-- Desktop search modal -->
    <div class="search-modal" id="search-modal-desktop">
        <button class="search-modal__close" id="search-close-desktop" aria-label="Close search">✖</button>
        <div class="search-modal__box">
            <form action="/search" method="get">
                <input type="text" name="q" placeholder="Search...">
                <button type="submit">Search</button>
            </form>
        </div>
    </div>

    <!-- Mobile search modal -->
    <div class="search-modal" id="search-modal-mobile">
        <button class="search-modal__close" id="search-close-mobile" aria-label="Close search">✖</button>
        <div class="search-modal__box">
            <form action="/search" method="get">
                <input type="text" name="q" placeholder="Search...">
                <button type="submit">Search</button>
            </form>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {

        // ----- Mobile hamburger menu -----
        var hamburgerBtn = document.getElementById('hamburger-btn');
        var mobileMenu = document.getElementById('mobile-menu');

        if (hamburgerBtn && mobileMenu) {
            hamburgerBtn.addEventListener('click', function () {
                var isOpen = mobileMenu.classList.toggle('is-open');
                hamburgerBtn.classList.toggle('is-open', isOpen);
                hamburgerBtn.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
            });
        }

        // ----- Mobile accordion dropdowns -----
        var mobileAccordions = document.querySelectorAll('.mobile-accordion');
        mobileAccordions.forEach(function (accordion) {
            var toggle = accordion.querySelector('.mobile-accordion__icon-btn');
            toggle.addEventListener('click', function (e) {
                e.stopPropagation();
                var isOpen = accordion.classList.toggle('is-open');
                toggle.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
            });
        });

        // ----- Desktop dropdowns (click to pin open, click again to close) -----
        var navItems = document.querySelectorAll('.nav-item');
        navItems.forEach(function (item) {
            var toggle = item.querySelector('.nav-item__icon-btn');
            toggle.addEventListener('click', function (e) {
                e.stopPropagation();
                var isOpen = item.classList.toggle('is-open');
                toggle.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
                navItems.forEach(function (otherItem) {
                    if (otherItem !== item) {
                        otherItem.classList.remove('is-open');
                        var otherToggle = otherItem.querySelector('.nav-item__icon-btn');
                        if (otherToggle) otherToggle.setAttribute('aria-expanded', 'false');
                    }
                });
            });
        });

        document.addEventListener('click', function () {
            navItems.forEach(function (item) {
                item.classList.remove('is-open');
                var toggle = item.querySelector('.nav-item__icon-btn');
                if (toggle) toggle.setAttribute('aria-expanded', 'false');
            });
        });

        // ----- Search modals -----
        function openModal(modal) {
            modal.classList.add('is-open');
            document.body.style.overflow = 'hidden';
        }
        function closeModal(modal) {
            modal.classList.remove('is-open');
            document.body.style.overflow = 'auto';
        }

        var searchOpenDesktop = document.getElementById('search-open-desktop');
        var searchModalDesktop = document.getElementById('search-modal-desktop');
        var searchCloseDesktop = document.getElementById('search-close-desktop');

        if (searchOpenDesktop && searchModalDesktop) {
            searchOpenDesktop.addEventListener('click', function () { openModal(searchModalDesktop); });
        }
        if (searchCloseDesktop && searchModalDesktop) {
            searchCloseDesktop.addEventListener('click', function () { closeModal(searchModalDesktop); });
        }

        var searchOpenMobile = document.getElementById('search-open-mobile');
        var searchModalMobile = document.getElementById('search-modal-mobile');
        var searchCloseMobile = document.getElementById('search-close-mobile');

        if (searchOpenMobile && searchModalMobile) {
            searchOpenMobile.addEventListener('click', function () { openModal(searchModalMobile); });
        }
        if (searchCloseMobile && searchModalMobile) {
            searchCloseMobile.addEventListener('click', function () { closeModal(searchModalMobile); });
        }

    });
</script>

