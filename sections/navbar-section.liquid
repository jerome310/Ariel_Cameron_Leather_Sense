<style>
    /* ===== Promo bar ===== */
    .promo-bar {
        padding: 1rem 2.5rem;
        background: linear-gradient(to right, rgba(254,184,43,0.5), rgba(229,97,161,0.5), rgba(254,184,43,0.5));
    }
    @media (min-width: 768px) {
        .promo-bar { padding: 1rem 0; }
    }
    .promo-bar__inner {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.75rem;
    }
    .promo-bar__emoji { font-size: 1.25rem; }
    .promo-bar__text {
        text-align: center;
        font-weight: 600;
        letter-spacing: 0.02em;
        color: #fff;
        text-shadow: 1px 1px 2px black;
        margin: 0;
    }

    /* ===== Header wrapper ===== */
    .site-header {
        display: flex;
        flex-direction: column;
        width: 100%;
        margin: 0 auto;
        padding-top: 1.25rem;
    }

    /* ===== Mobile top bar ===== */
    .mobile-topbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0.75rem 1rem;
    }
    @media (min-width: 768px) {
        .mobile-topbar { display: none; }
    }
    .hamburger-btn {
        background: none;
        border: none;
        color: #2E2D34;
        cursor: pointer;
        padding: 0;
        line-height: 0;
    }
    .hamburger-btn svg { width: 24px; height: 24px; }
    .hamburger-btn .icon-close { display: none; }
    .hamburger-btn.is-open .icon-open { display: none; }
    .hamburger-btn.is-open .icon-close { display: block; }

    .mobile-logo img { width: 120px; height: 120px; }

    .mobile-actions {
        display: flex;
        align-items: center;
        gap: 1rem;
        color: #2E2D34;
    }
    .mobile-actions button {
        background: none;
        border: none;
        cursor: pointer;
        color: inherit;
        padding: 0;
    }

    /* ===== Mobile slide-out menu ===== */
    .mobile-menu {
        background: rgba(254,184,43,0.2);
        max-height: 0;
        overflow: hidden;
        transition: max-height 0.3s ease;
    }
    @media (min-width: 768px) {
        .mobile-menu { display: none; }
    }
    .mobile-menu.is-open { max-height: 800px; }

    .mobile-menu__links {
        display: flex;
        flex-direction: column;
        padding: 1.5rem 1rem 0 1rem;
        gap: 0.5rem;
    }

    .mobile-nav-link {
        font-weight: 400;
        color: #000;
        text-decoration: none;
        display: block;
        padding: 0.5rem 0.75rem;
        border-radius: 0.375rem;
        font-size: 1rem;
    }
    .mobile-nav-link:hover { text-decoration: underline; text-underline-offset: 4px; }

    .mobile-accordion { border-bottom: 1px solid rgba(0,0,0,0.06); }
    .mobile-accordion:last-child { border-bottom: none; }

    .mobile-accordion__toggle {
        width: 100%;
        display: flex;
        align-items: center;
        justify-content: space-between;
        background: none;
        border: none;
        cursor: pointer;
        font-family: inherit;
        text-align: left;
        font-weight: 400;
        color: #000;
        padding: 0.75rem;
        border-radius: 0.375rem;
        font-size: 1rem;
    }
    .mobile-accordion__toggle:hover { text-decoration: underline; text-underline-offset: 4px; }

    .mobile-accordion__icon {
        width: 10px;
        height: 10px;
        flex-shrink: 0;
        margin-left: 0.5rem;
        transition: transform 0.3s ease-in-out;
    }
    .mobile-accordion__toggle:hover .mobile-accordion__icon { transform: rotate(-180deg); }
    .mobile-accordion.is-open .mobile-accordion__icon { transform: rotate(-180deg); }

    .mobile-accordion__panel {
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
        padding: 0 0.75rem 0 1.5rem;
        max-height: 0;
        overflow: hidden;
        transition: max-height 0.3s ease;
    }
    .mobile-accordion.is-open .mobile-accordion__panel {
        max-height: 500px;
        padding-bottom: 0.75rem;
    }

    .mobile-accordion__link {
        font-weight: 400;
        color: #5E5C66;
        text-decoration: none;
        display: block;
        padding: 0.625rem 0.75rem;
        border-radius: 0.375rem;
        font-size: 0.875rem;
        transition: background-color 0.15s ease, color 0.15s ease;
    }
    .mobile-accordion__link:hover {
        background: rgba(254,184,43,0.1);
        color: #2E2D34;
        text-decoration: underline;
        text-underline-offset: 4px;
    }

    .mobile-menu__social {
        display: flex;
        padding: 2rem 1.5rem 1.5rem 1.5rem;
        gap: 1rem;
    }

    /* ===== Desktop nav ===== */
    .desktop-nav {
        display: none;
        align-items: center;
        justify-content: space-between;
        width: 100%;
        margin-top: 1rem;
        padding: 0 1.5rem;
    }
    @media (min-width: 768px) {
        .desktop-nav { display: flex; }
    }

    .desktop-nav__links {
        flex: 1;
        display: flex;
        gap: 2rem;
    }

    .desktop-nav-link {
        font-weight: 400;
        color: #5E5C66;
        text-decoration: none;
        display: block;
        padding: 0.5rem 0;
        font-size: 1.125rem;
    }
    .desktop-nav-link:hover { text-decoration: underline; text-underline-offset: 4px; }

    .nav-item { position: relative; }

    .nav-item__toggle {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        background: none;
        border: none;
        cursor: pointer;
        font-family: inherit;
        font-weight: 400;
        color: #5E5C66;
        padding: 0.5rem 0;
        font-size: 1.125rem;
    }
    .nav-item__toggle:hover { text-decoration: underline; text-underline-offset: 4px; }

    .nav-item__icon {
        width: 8px;
        height: 8px;
        flex-shrink: 0;
        transition: transform 0.3s ease-in-out;
    }
    .nav-item:hover .nav-item__icon,
    .nav-item.is-open .nav-item__icon {
        transform: rotate(-180deg);
    }

    .nav-dropdown {
        position: absolute;
        left: 50%;
        top: 100%;
        margin-top: 0.75rem;
        width: max-content;
        min-width: 320px;
        background: #fff;
        border: 1px solid #f0f0f0;
        border-radius: 0.75rem;
        box-shadow: 0 10px 25px rgba(0,0,0,0.15);
        overflow: hidden;
        z-index: 40;
        opacity: 0;
        visibility: hidden;
        transform: translate(-50%, -4px);
        transition: opacity 0.15s ease, transform 0.15s ease, visibility 0.15s;
    }
    .nav-item:hover .nav-dropdown,
    .nav-item.is-open .nav-dropdown {
        opacity: 1;
        visibility: visible;
        transform: translate(-50%, 0);
    }

    .nav-dropdown__arrow {
        position: absolute;
        top: -6px;
        left: 50%;
        transform: translateX(-50%) rotate(45deg);
        width: 12px;
        height: 12px;
        background: #fff;
        border-top: 1px solid #f0f0f0;
        border-left: 1px solid #f0f0f0;
    }

    .nav-dropdown__list { position: relative; padding: 0.5rem 0; }
    .nav-dropdown__list a {
        display: block;
        white-space: nowrap;
        padding: 0.875rem 2rem;
        font-size: 1rem;
        font-weight: 400;
        color: #5E5C66;
        text-decoration: none;
        border-bottom: 1px solid #f3f4f6;
        transition: background-color 0.15s ease, color 0.15s ease;
    }
    .nav-dropdown__list a:last-child { border-bottom: none; }
    .nav-dropdown__list a:hover { background: rgba(254,184,43,0.1); color: #2E2D34; }

    .desktop-logo { flex-shrink: 0; margin: 0 auto; }
    .desktop-logo--default img { width: 135px; height: auto; }
    .desktop-logo--custom img { width: 180px; height: 180px; }
    @media (min-width: 768px) {
        .desktop-logo--default img { width: 175px; }
        .desktop-logo--custom img { width: 200px; height: 200px; }
    }

    .desktop-actions {
        flex: 1;
        display: flex;
        justify-content: flex-end;
        align-items: center;
        gap: 2rem;
    }
    .icon-btn {
        background: none;
        border: none;
        cursor: pointer;
        color: #6b7280;
        white-space: nowrap;
        font-size: 1rem;
        padding: 0;
    }
    .icon-btn:hover { color: #111827; }

    /* ===== Search modals ===== */
    .search-modal {
        display: none;
        position: fixed;
        inset: 0;
        background: rgba(0,0,0,0.5);
        align-items: center;
        justify-content: center;
        z-index: 50;
        opacity: 0;
        transition: opacity 0.25s ease;
    }
    .search-modal.is-open { display: flex; opacity: 1; }

    .search-modal__close {
        position: fixed;
        top: 1rem;
        right: 1rem;
        z-index: 9999;
        font-size: 2rem;
        color: #000;
        background: transparent;
        border: none;
        cursor: pointer;
    }

    .search-modal__box {
        background: #fff;
        padding: 1rem;
        border-radius: 0.375rem;
        width: 75%;
        position: relative;
    }
    @media (min-width: 768px) {
        .search-modal__box { width: 33.333%; }
    }
    .search-modal__box input {
        width: 100%;
        padding: 0.5rem 1rem;
        border: 1px solid #d1d5db;
        border-radius: 0.375rem;
        box-sizing: border-box;
    }
    .search-modal__box button[type="submit"] {
        margin-top: 0.5rem;
        width: 100%;
        background: #FEB82B;
        color: #fff;
        padding: 0.5rem;
        border: none;
        border-radius: 0.375rem;
        cursor: pointer;
    }
</style>

<div class="promo-bar">
    <div class="promo-bar__inner">
        <span class="promo-bar__emoji" aria-hidden="true">🚨</span>
        <p class="promo-bar__text" aria-label="Welcome message">
            NEW 'Charm + Wallet Collection' Drop Here!
        </p>
        <span class="promo-bar__emoji" aria-hidden="true">🚨</span>
    </div>
</div>

<div class="site-header" id="site-header">

    <!-- Mobile top bar -->
    <div class="mobile-topbar">
        <button class="hamburger-btn" id="hamburger-btn" type="button" aria-expanded="false" aria-controls="mobile-menu">
            <svg class="icon-open" viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-label="Open menu">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
            </svg>
            <svg class="icon-close" viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-label="Close menu">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
            </svg>
        </button>

        <div class="mobile-logo">
            <a href="{{ shop.url }}" title="Homepage">
                {% if section.settings.image == blank %}
                <img src="{{ 'Header_ACL_Logo.png' | asset_url }}" alt="My company logo">
                {% else %}
                <img src="{{ section.settings.image | img_url: 'master' }}" alt="My company logo">
                {% endif %}
            </a>
        </div>

        <div class="mobile-actions">
            <button type="button" id="search-open-mobile" aria-label="Open mobile search bar">
                {% render 'icon-search' %}
            </button>
            {% render 'icon-cart' %}
        </div>
    </div>

    <!-- Mobile slide-out menu -->
    <div class="mobile-menu" id="mobile-menu">
        <div class="mobile-menu__links">
            {% if linklists.main-menu.links.size > 0 %}
            {% for link in linklists.main-menu.links %}
                {% if link.links.size > 0 %}
                <div class="mobile-accordion">
                    <button type="button" class="mobile-accordion__toggle" aria-expanded="false">
                        <span>{{ link.title }}</span>
                        <svg class="mobile-accordion__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                        </svg>
                    </button>
                    <div class="mobile-accordion__panel">
                        {% for childlink in link.links %}
                        <a class="mobile-accordion__link" href="{{ childlink.url }}" title="{{ childlink.title }}">{{ childlink.title }}</a>
                        {% endfor %}
                    </div>
                </div>
                {% else %}
                <a class="mobile-nav-link" href="{{ link.url }}" title="{{ link.title }}">{{ link.title }}</a>
                {% endif %}
            {% endfor %}
            {% else %}
            <p>No menu links available.</p>
            {% endif %}
        </div>
        <div class="mobile-menu__social">
            {% render 'social-media-twitter' %}
            {% render 'social-media-facebook' %}
            {% render 'social-media-pinterest' %}
            {% render 'social-media-instagram' %}
            {% render 'social-media-tiktok' %}
        </div>
    </div>

    <!-- Desktop nav -->
    <div class="desktop-nav">
        <div class="desktop-nav__links">
            {% if linklists.main-menu.links.size > 0 %}
            {% for link in linklists.main-menu.links %}
                {% if link.links.size > 0 %}
                <div class="nav-item">
                    <button type="button" class="nav-item__toggle" aria-expanded="false">
                        <span>{{ link.title }}</span>
                        <svg class="nav-item__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                        </svg>
                    </button>
                    <div class="nav-dropdown">
                        <div class="nav-dropdown__arrow"></div>
                        <div class="nav-dropdown__list">
                            {% for childlink in link.links %}
                            <a href="{{ childlink.url }}" title="{{ childlink.title }}">{{ childlink.title }}</a>
                            {% endfor %}
                        </div>
                    </div>
                </div>
                {% else %}
                <a class="desktop-nav-link" href="{{ link.url }}" title="{{ link.title }}">{{ link.title }}</a>
                {% endif %}
            {% endfor %}
            {% endif %}
        </div>

        <div class="desktop-logo {% if section.settings.image == blank %}desktop-logo--default{% else %}desktop-logo--custom{% endif %}">
            <a href="{{ shop.url }}" title="Homepage">
                {% if section.settings.image == blank %}
                <img src="{{ 'Header_ACL_Logo.png' | asset_url }}" alt="My company logo">
                {% else %}
                <img src="{{ section.settings.image | img_url: 'master' }}" alt="My company logo">
                {% endif %}
            </a>
        </div>

        <div class="desktop-actions">
            <button type="button" class="icon-btn" id="search-open-desktop" aria-label="Open search bar">
                {% render 'icon-search' %}
            </button>
            {% render 'icon-cart' %}
        </div>
    </div>

    <!-- Desktop search modal -->
    <div class="search-modal" id="search-modal-desktop">
        <button class="search-modal__close" id="search-close-desktop" aria-label="Close search">✖</button>
        <div class="search-modal__box">
            <form action="/search" method="get">
                <input type="text" name="q" placeholder="Search...">
                <button type="submit">Search</button>
            </form>
        </div>
    </div>

    <!-- Mobile search modal -->
    <div class="search-modal" id="search-modal-mobile">
        <button class="search-modal__close" id="search-close-mobile" aria-label="Close search">✖</button>
        <div class="search-modal__box">
            <form action="/search" method="get">
                <input type="text" name="q" placeholder="Search...">
                <button type="submit">Search</button>
            </form>
        </div>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function () {

    // ----- Mobile hamburger menu -----
    var hamburgerBtn = document.getElementById('hamburger-btn');
    var mobileMenu = document.getElementById('mobile-menu');

    if (hamburgerBtn && mobileMenu) {
        hamburgerBtn.addEventListener('click', function () {
            var isOpen = mobileMenu.classList.toggle('is-open');
            hamburgerBtn.classList.toggle('is-open', isOpen);
            hamburgerBtn.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
        });
    }

    // ----- Mobile accordion dropdowns -----
    var mobileAccordions = document.querySelectorAll('.mobile-accordion');
    mobileAccordions.forEach(function (accordion) {
        var toggle = accordion.querySelector('.mobile-accordion__toggle');
        toggle.addEventListener('click', function () {
            var isOpen = accordion.classList.toggle('is-open');
            toggle.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
        });
    });

    // ----- Desktop dropdowns (click to pin open, click again to close) -----
    var navItems = document.querySelectorAll('.nav-item');
    navItems.forEach(function (item) {
        var toggle = item.querySelector('.nav-item__toggle');
        toggle.addEventListener('click', function (e) {
            e.stopPropagation();
            var isOpen = item.classList.toggle('is-open');
            toggle.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
            navItems.forEach(function (otherItem) {
                if (otherItem !== item) {
                    otherItem.classList.remove('is-open');
                    var otherToggle = otherItem.querySelector('.nav-item__toggle');
                    if (otherToggle) otherToggle.setAttribute('aria-expanded', 'false');
                }
            });
        });
    });

    document.addEventListener('click', function () {
        navItems.forEach(function (item) {
            item.classList.remove('is-open');
            var toggle = item.querySelector('.nav-item__toggle');
            if (toggle) toggle.setAttribute('aria-expanded', 'false');
        });
    });

    // ----- Search modals -----
    function openModal(modal) {
        modal.classList.add('is-open');
        document.body.style.overflow = 'hidden';
    }
    function closeModal(modal) {
        modal.classList.remove('is-open');
        document.body.style.overflow = 'auto';
    }

    var searchOpenDesktop = document.getElementById('search-open-desktop');
    var searchModalDesktop = document.getElementById('search-modal-desktop');
    var searchCloseDesktop = document.getElementById('search-close-desktop');

    if (searchOpenDesktop && searchModalDesktop) {
        searchOpenDesktop.addEventListener('click', function () { openModal(searchModalDesktop); });
    }
    if (searchCloseDesktop && searchModalDesktop) {
        searchCloseDesktop.addEventListener('click', function () { closeModal(searchModalDesktop); });
    }

    var searchOpenMobile = document.getElementById('search-open-mobile');
    var searchModalMobile = document.getElementById('search-modal-mobile');
    var searchCloseMobile = document.getElementById('search-close-mobile');

    if (searchOpenMobile && searchModalMobile) {
        searchOpenMobile.addEventListener('click', function () { openModal(searchModalMobile); });
    }
    if (searchCloseMobile && searchModalMobile) {
        searchCloseMobile.addEventListener('click', function () { closeModal(searchModalMobile); });
    }

});
</script>

{% schema %}
{
"name": "Logo",
"settings": [
{
"type": "image_picker",
"id": "image",
"label": "Image"
}
]
}
{% endschema %}
