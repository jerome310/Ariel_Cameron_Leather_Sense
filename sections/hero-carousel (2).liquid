<style>
    .header-carousel {
        margin-top: 0;
        position: relative;
        width: 100%;
        overflow: hidden;
        font-family: Georgia, 'Times New Roman', serif;
    }

    .carousel-slides {
        position: relative;
        height: calc(55vh + 150px);
    }

    @media (min-width: 768px) {
        .carousel-slides {
            height: calc(62vh + 170px);
            max-height: 750px;
        }
    }

    .carousel-slide {
        position: absolute;
        inset: 0;
        display: flex;
        flex-direction: column;
        opacity: 0;
        pointer-events: none;
        transition: opacity 0.9s ease;
    }

    .carousel-slide.is-active {
        opacity: 1;
        pointer-events: auto;
    }

    /* Image area: full width, uncropped product, neutral backdrop fills any empty space */
    .carousel-slide-media {
        position: relative;
        flex: 1;
        min-height: 0;
        background: #EDE7D8;
    }

    .carousel-slide-media img {
        width: 100%;
        height: 100%;
        object-fit: contain;
        object-position: center;
    }

    /* Text area: sits below the image, on its own background, not overlaid */
    .carousel-content {
        flex-shrink: 0;
        background: #FBFAF7;
        border-top: 1px solid #E5E1D8;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.6rem;
        width: 100%;
        max-width: 1200px;
        margin: 0 auto;
        padding: 1.5rem 2rem;
        text-align: center;
    }

    .carousel-eyebrow {
        color: #B8941F;
        font-size: 0.7rem;
        font-weight: 400;
        letter-spacing: 0.22em;
        text-transform: uppercase;
        margin: 0;
    }

    .carousel-heading {
        color: #1A1A18;
        font-size: 1.35rem;
        font-style: italic;
        font-weight: 400;
        margin: 0;
    }

    @media (min-width: 768px) {
        .carousel-heading {
            font-size: 1.85rem;
        }
    }

    .carousel-btn {
        background: #1A1A18;
        color: #fff;
        padding: 0.65rem 1.5rem;
        border-radius: 2px;
        font-family: Georgia, serif;
        font-size: 0.7rem;
        font-weight: 700;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        text-decoration: none;
        transition: transform 0.25s ease, background-color 0.25s ease;
        display: inline-block;
        margin-top: 0.3rem;
    }

    .carousel-btn:hover {
        background: #2784FE;
        transform: translateY(-1px);
    }

    .carousel-arrow {
        position: absolute;
        top: calc(50% - 60px);
        transform: translateY(-50%);
        background: rgba(255, 255, 255, 0.85);
        color: #1A1A18;
        width: 2.5rem;
        height: 2.5rem;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 9999px;
        border: none;
        cursor: pointer;
        z-index: 30;
        font-size: 0.9rem;
        line-height: 1;
        transition: background-color 0.2s ease;
    }

    .carousel-arrow:hover {
        background: #fff;
    }

    .carousel-arrow-left {
        left: 1.25rem;
    }

    .carousel-arrow-right {
        right: 1.25rem;
    }

    .carousel-dots {
        position: absolute;
        bottom: 108px;
        left: 50%;
        transform: translateX(-50%);
        display: flex;
        gap: 0.5rem;
        z-index: 30;
    }

    .carousel-dot {
        width: 0.4rem;
        height: 0.4rem;
        border-radius: 9999px;
        border: none;
        cursor: pointer;
        background: #D8D4C8;
        padding: 0;
        transition: background-color 0.2s ease, transform 0.2s ease;
    }

    .carousel-dot.active {
        background: #1A1A18;
        transform: scale(1.3);
    }
</style>

<!-- Header Carousel (vanilla JS, no Alpine dependency) -->
<div class="header-carousel" id="hero-carousel" data-autoplay-ms="6500">

    <div class="carousel-slides">

        <div class="carousel-slide is-active" data-slide="0">
            <div class="carousel-slide-media">
                <img src="{{ 'strawberry-charm.jpeg' | asset_url }}" alt="Strawberry-shaped leather charm, hand-dyed and hand-stitched">
            </div>
            <div class="carousel-content">
                <p class="carousel-eyebrow">Handcrafted in America</p>
                <h2 class="carousel-heading">The Charm Collection, in living color</h2>
                <a href="https://arielcameronleather.com/collections/charm?pb=0" class="carousel-btn">
                    Shop Charm Collection
                </a>
            </div>
        </div>

        <div class="carousel-slide" data-slide="1">
            <div class="carousel-slide-media">
                <img src="{{ 'bread-charm.jpeg' | asset_url }}" alt="Bread-shaped leather charm, hand-dyed and hand-stitched">
            </div>
            <div class="carousel-content">
                <p class="carousel-eyebrow">Handcrafted in America</p>
                <h2 class="carousel-heading">No sewing machine. No neutrals.</h2>
                <a href="https://arielcameronleather.com/collections/charm?pb=0" class="carousel-btn">
                    Shop Charm Collection
                </a>
            </div>
        </div>

        <div class="carousel-slide" data-slide="2">
            <div class="carousel-slide-media">
                <img src="{{ 'butter-wallet.jpeg' | asset_url }}" alt="Butter-shaped leather wallet, hand-dyed and hand-stitched">
            </div>
            <div class="carousel-content">
                <p class="carousel-eyebrow">Handcrafted in America</p>
                <h2 class="carousel-heading">One-of-one original designs</h2>
                <a href="https://arielcameronleather.com/collections/charm?pb=0" class="carousel-btn">
                    Shop Charm Collection
                </a>
            </div>
        </div>

        <div class="carousel-slide" data-slide="3">
            <div class="carousel-slide-media">
                <img src="{{ 'butter-charm.jpeg' | asset_url }}" alt="Butter-shaped leather charm, hand-dyed and hand-stitched">
            </div>
            <div class="carousel-content">
                <p class="carousel-eyebrow">Handcrafted in America</p>
                <h2 class="carousel-heading">Small-batch. Full-grain. Yours alone.</h2>
                <a href="https://arielcameronleather.com/collections/charm?pb=0" class="carousel-btn">
                    Shop Charm Collection
                </a>
            </div>
        </div>

        <div class="carousel-slide" data-slide="4">
            <div class="carousel-slide-media">
                <img src="{{ 'pickle-charm.jpeg' | asset_url }}" alt="Pickle-shaped leather charm, hand-dyed and hand-stitched">
            </div>
            <div class="carousel-content">
                <p class="carousel-eyebrow">Handcrafted in America</p>
                <h2 class="carousel-heading">Leather, unapologetically in color</h2>
                <a href="https://arielcameronleather.com/collections/charm?pb=0" class="carousel-btn">
                    Shop Charm Collection
                </a>
            </div>
        </div>

    </div>

    <button type="button" class="carousel-arrow carousel-arrow-left" data-carousel-prev aria-label="Previous slide">
        &#10094;
    </button>
    <button type="button" class="carousel-arrow carousel-arrow-right" data-carousel-next aria-label="Next slide">
        &#10095;
    </button>

    <div class="carousel-dots">
        <button type="button" class="carousel-dot active" data-carousel-dot="0" aria-label="Go to slide 1"></button>
        <button type="button" class="carousel-dot" data-carousel-dot="1" aria-label="Go to slide 2"></button>
        <button type="button" class="carousel-dot" data-carousel-dot="2" aria-label="Go to slide 3"></button>
        <button type="button" class="carousel-dot" data-carousel-dot="3" aria-label="Go to slide 4"></button>
        <button type="button" class="carousel-dot" data-carousel-dot="4" aria-label="Go to slide 5"></button>
    </div>

</div>

<script>
(function () {
    var root = document.getElementById('hero-carousel');
    if (!root) return;

    var slides = Array.prototype.slice.call(root.querySelectorAll('.carousel-slide'));
    var dots = Array.prototype.slice.call(root.querySelectorAll('[data-carousel-dot]'));
    var prevBtn = root.querySelector('[data-carousel-prev]');
    var nextBtn = root.querySelector('[data-carousel-next]');
    var autoplayMs = parseInt(root.getAttribute('data-autoplay-ms'), 10) || 6500;

    var current = 0;
    var total = slides.length;
    var timer = null;

    function goToSlide(index) {
        current = (index + total) % total;

        slides.forEach(function (slide, i) {
            slide.classList.toggle('is-active', i === current);
        });

        dots.forEach(function (dot, i) {
            dot.classList.toggle('active', i === current);
        });
    }

    function nextSlide() {
        goToSlide(current + 1);
    }

    function prevSlide() {
        goToSlide(current - 1);
    }

    function startAutoplay() {
        stopAutoplay();
        timer = setInterval(nextSlide, autoplayMs);
    }

    function stopAutoplay() {
        if (timer) {
            clearInterval(timer);
            timer = null;
        }
    }

    if (nextBtn) {
        nextBtn.addEventListener('click', function () {
            nextSlide();
            startAutoplay();
        });
    }

    if (prevBtn) {
        prevBtn.addEventListener('click', function () {
            prevSlide();
            startAutoplay();
        });
    }

    dots.forEach(function (dot, i) {
        dot.addEventListener('click', function () {
            goToSlide(i);
            startAutoplay();
        });
    });

    goToSlide(0);
    startAutoplay();
})();
</script>
