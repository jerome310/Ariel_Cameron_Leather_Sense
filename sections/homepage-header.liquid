<style>
    /* FULL WIDTH FIX */
    .hero-banner {
        position: relative;
        width: 100%;
        margin-left: 0;
        overflow: hidden;
        height: 1250px;
    }

    .hero-image {
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: bottom;

    }

    /* OVERLAY */
    .hero-overlay {
    position: absolute;
    top: auto;
    bottom: 180px;
    left: 80px;
    transform: none;
    z-index: 10;
}

    /* TEXT IMAGE STACK */
    .hero-text-images {
        display: flex;
        flex-direction: column;
        gap: 5px;
        margin-bottom: 15px;
    }

    

    /* BUTTON */
    .hero-btn {
        display: inline-block;
    padding: 12px 26px;
    background: white;
    color: black;
    text-decoration: none;
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 1px;
    transition: all 0.3s ease;
    }

    /* HOVER */
    .hero-btn:hover {
        background: black;
        color: white;
    }

    /* OPTIONAL DARK FADE */
    .hero-banner::after {
        content: "";
        position: absolute;
        bottom: 0;
        left: 0;
        right: 0;
        height: 40%;
    }

    .hero-image {
        width: 100%;
        height: auto;
        display: block;
    }

    /* TABLET */
    @media screen and (max-width: 768px) {

        .hero-overlay {
            top: 50%;
            /* 👈 push it down */
            left: 40px;
            transform: none;
            /* 👈 IMPORTANT */
        }

    }

    @media screen and (max-height: 700px) and (max-width: 1023px) {

    .hero-overlay {
        top: 32%;
        bottom: 30px;
    }

    .hero-text-images img {
        max-width: 350px;
        width: 70vw;
    }

}

  @media screen and (min-width: 1024px) {
    .hero-text-images img {
        width: 550px;
        max-width: 100%;
    }

    .hero-overlay {
        left: 50px; /* move left/right */
        bottom: 500px; /* move up/down */
    }
}


    /* MOBILE */
    @media screen and (max-width: 480px) {

        .hero-banner {
            height: 700px;
        }

        .hero-overlay {
            top: 45%;
            /* 👈 push it LOWER */
            left: 20px;
            right: 20px;
            transform: none;
            /* 👈 remove centering */
        }

        .hero-image {
            object-fit: contain;
            object-position: center;
            background: #ffffff;
        }

        .hero-text-images img {
            width: 220px;
        }

        .hero-btn {
            margin-top: 10px;
            padding: 10px 22px;
            font-size: 13px;
        }

    }
</style>

<div class="hero-banner">
    <img src="{{ 'acl_ceo_strawberry_img.jpeg' | asset_url }}" alt="Strawberry Bag" class="hero-image">

    <div class="hero-overlay">
        <div class="hero-text-images">
            <img src="{{ 'New Strawberry Collection Verbiage.png' | asset_url }}" alt="Strawberry verbiage">
        </div>

        <a href="/collections/strawberry-product-drop" class="hero-btn">Shop Now</a>
    </div>
</div>