<style>
    .header-carousel {
        position: relative;
        width: 100%;
        overflow: hidden;
    }

    .carousel-slides {
        position: relative;
        width: 100%;
        height: 480px;
        /* mobile */
        display: flex;
        align-items: center;
        justify-content: center;
    }

    @media (min-width: 768px) {
        .carousel-slides {
            height: 640px;
            /* desktop — keeps CTA inside the fold on most laptop viewports */
        }
    }

    .carousel-slide {
        position: absolute;
        inset: 0;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .carousel-slide-bg {
        position: absolute;
        inset: 0;
        background: linear-gradient(to right, #feb82b, #2387ff, #e561a1);
        z-index: 0;
    }

    .carousel-slide img {
        position: relative;
        z-index: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: center;
    }

    .carousel-gradient-overlay {
        position: absolute;
        left: 0;
        right: 0;
        bottom: 0;
        height: 55%;
        background: linear-gradient(to top, rgba(0, 0, 0, 0.55), rgba(0, 0, 0, 0) 70%);
        z-index: 10;
    }

    .carousel-content {
        position: absolute;
        left: 6%;
        bottom: 8%;
        right: 6%;
        z-index: 20;
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: 0.6rem;
        max-width: 640px;
    }

    .carousel-eyebrow {
        color: white;
        font-size: 1rem;
        font-weight: 700;
        margin: 0;
        text-shadow: 0 1px 6px rgba(0, 0, 0, 0.5);
    }

    .carousel-heading {
        color: white;
        font-family: Georgia, "Times New Roman", serif;
        font-style: italic;
        font-size: 2.75rem;
        line-height: 1.1;
        font-weight: 400;
        text-align: left;
        margin: 0 0 0.75rem 0;
        text-shadow: 0 1px 10px rgba(0, 0, 0, 0.5);
    }

    @media (max-width: 767px) {
        .carousel-heading {
            font-size: 1.6rem;
        }

        .carousel-content {
            bottom: 12%;
        }
    }

    .carousel-btn {
        background: black;
        color: white;
        padding: 0.85rem 1.75rem;
        border-radius: 0;
        font-weight: 600;
        font-size: 0.85rem;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        text-decoration: none;
        transition: transform 0.3s ease, background-color 0.3s ease;
        display: inline-block;
    }

    .carousel-btn:hover {
        background: #222;
        transform: scale(1.03);
    }

    .carousel-arrow {
        position: absolute;
        top: 50%;
        transform: translateY(-50%);
        background: rgba(0, 0, 0, 0.5);
        color: white;
        padding: 0.75rem;
        border-radius: 9999px;
        border: none;
        cursor: pointer;
        z-index: 30;
        font-size: 1rem;
        line-height: 1;
    }

    .carousel-arrow:hover {
        background: rgba(0, 0, 0, 0.7);
    }

    .carousel-arrow-left {
        left: 1rem;
    }

    .carousel-arrow-right {
        right: 1rem;
    }

    /* dots moved to bottom-right */
    .carousel-dots {
        position: absolute;
        bottom: 1.25rem;
        right: 1.5rem;
        left: auto;
        transform: none;
        display: flex;
        gap: 0.5rem;
        z-index: 30;
    }

    .carousel-dot {
        width: 0.75rem;
        height: 0.75rem;
        border-radius: 9999px;
        border: none;
        cursor: pointer;
        background: rgba(255, 255, 255, 0.5);
        padding: 0;
    }

    .carousel-dot.active {
        background: white;
    }

    /* Fade transition classes used by Alpine's x-transition */
    .fade-enter {
        transition: opacity 0.7s ease-out;
    }

    .fade-enter-start {
        opacity: 0;
    }

    .fade-enter-end {
        opacity: 1;
    }

    .fade-leave {
        transition: opacity 0.7s ease-in;
    }

    .fade-leave-start {
        opacity: 1;
    }

    .fade-leave-end {
        opacity: 0;
    }
</style>

<!-- Header Carousel -->
<div class="header-carousel" x-data="{ current: 0, slides: 5 }"
    x-init="setInterval(() => { current = (current < slides - 1 ? current + 1 : 0) }, 5000)">

    <!-- Slides container -->
    <div class="carousel-slides">

        <!-- Slide 1 -->
        <div x-show="current === 0" x-transition:enter="fade-enter" x-transition:enter-start="fade-enter-start"
            x-transition:enter-end="fade-enter-end" x-transition:leave="fade-leave"
            x-transition:leave-start="fade-leave-start" x-transition:leave-end="fade-leave-end" class="carousel-slide">

            <div class="carousel-slide-bg"></div>
            <img src="{{ 'strawberry-charm.jpeg' | asset_url }}" alt="Slide 1">
            <div class="carousel-gradient-overlay"></div>

            <div class="carousel-content">
                <p class="carousel-eyebrow">Handcrafted in America</p>
                <h2 class="carousel-heading">
                    Handcrafted &amp; hand-stitched&mdash;no sewing machine
                </h2>
                <a href="https://arielcameronleather.com/collections/charm?pb=0" class="carousel-btn">
                    Shop Charm Collection
                </a>
            </div>
        </div>

        <!-- Slide 2 -->
        <div x-show="current === 1" x-transition:enter="fade-enter" x-transition:enter-start="fade-enter-start"
            x-transition:enter-end="fade-enter-end" x-transition:leave="fade-leave"
            x-transition:leave-start="fade-leave-start" x-transition:leave-end="fade-leave-end" class="carousel-slide">

            <div class="carousel-slide-bg"></div>
            <img src="{{ 'bread-charm.jpeg' | asset_url }}" alt="Slide 2">
            <div class="carousel-gradient-overlay"></div>

            <div class="carousel-content">
                <p class="carousel-eyebrow">Handcrafted in America</p>
                <h2 class="carousel-heading">
                    You had me at polka dots
                </h2>
                <a href="https://arielcameronleather.com/collections/charm?pb=0" class="carousel-btn">
                    Shop Charm Collection
                </a>
            </div>
        </div>

        <!-- Slide 3 -->
        <div x-show="current === 2" x-transition:enter="fade-enter" x-transition:enter-start="fade-enter-start"
            x-transition:enter-end="fade-enter-end" x-transition:leave="fade-leave"
            x-transition:leave-start="fade-leave-start" x-transition:leave-end="fade-leave-end" class="carousel-slide">

            <div class="carousel-slide-bg"></div>
            <img src="{{ 'butter-wallet.jpeg' | asset_url }}" alt="Slide 3">
            <div class="carousel-gradient-overlay"></div>

            <div class="carousel-content">
                <p class="carousel-eyebrow">Handcrafted in America</p>
                <h2 class="carousel-heading">
                    One-of-one original designs
                </h2>
                <a href="https://arielcameronleather.com/collections/charm?pb=0" class="carousel-btn">
                    Shop Charm Collection
                </a>
            </div>
        </div>

        <!-- Slide 4 -->
        <div x-show="current === 3" x-transition:enter="fade-enter" x-transition:enter-start="fade-enter-start"
            x-transition:enter-end="fade-enter-end" x-transition:leave="fade-leave"
            x-transition:leave-start="fade-leave-start" x-transition:leave-end="fade-leave-end" class="carousel-slide">

            <div class="carousel-slide-bg"></div>
            <img src="{{ 'butter-charm.jpeg' | asset_url }}" alt="Slide 4">
            <div class="carousel-gradient-overlay"></div>

            <div class="carousel-content">
                <p class="carousel-eyebrow">Handcrafted in America</p>
                <h2 class="carousel-heading">
                    One-of-one original designs
                </h2>
                <a href="https://arielcameronleather.com/collections/charm?pb=0" class="carousel-btn">
                    Shop Charm Collection
                </a>
            </div>
        </div>

        <!-- Slide 5 -->
        <div x-show="current === 4" x-transition:enter="fade-enter" x-transition:enter-start="fade-enter-start"
            x-transition:enter-end="fade-enter-end" x-transition:leave="fade-leave"
            x-transition:leave-start="fade-leave-start" x-transition:leave-end="fade-leave-end" class="carousel-slide">

            <div class="carousel-slide-bg"></div>
            <img src="{{ 'pickle-charm.jpeg' | asset_url }}" alt="Slide 5">
            <div class="carousel-gradient-overlay"></div>

            <div class="carousel-content">
                <p class="carousel-eyebrow">Handcrafted in America</p>
                <h2 class="carousel-heading">
                    One-of-one original designs
                </h2>
                <a href="https://arielcameronleather.com/collections/charm?pb=0" class="carousel-btn">
                    Shop Charm Collection
                </a>
            </div>
        </div>

    </div>

    <!-- Navigation Arrows -->
    <button @click="current = (current > 0 ? current - 1 : slides - 1)" class="carousel-arrow carousel-arrow-left">
        &#10094;
    </button>
    <button @click="current = (current < slides - 1 ? current + 1 : 0)" class="carousel-arrow carousel-arrow-right">
        &#10095;
    </button>

    <!-- Dots -->
    <div class="carousel-dots">
        <button @click="current = 0" :class="{ active: current === 0 }" class="carousel-dot"></button>
        <button @click="current = 1" :class="{ active: current === 1 }" class="carousel-dot"></button>
        <button @click="current = 2" :class="{ active: current === 2 }" class="carousel-dot"></button>
        <button @click="current = 3" :class="{ active: current === 3 }" class="carousel-dot"></button>
        <button @click="current = 4" :class="{ active: current === 4 }" class="carousel-dot"></button>
    </div>

</div>