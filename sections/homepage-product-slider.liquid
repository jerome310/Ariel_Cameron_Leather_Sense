<style>
    .header-carousel {
        margin-top: 40px;
        position: relative;
        width: 100%;
        overflow: hidden;
    }

    .carousel-slides {
        position: relative;
        height: 185vh !important;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    @media (min-width: 768px) {
        .carousel-slides {
            height: 90vh;
        }
    }

    .carousel-slide {
        position: absolute;
        inset: 0;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .carousel-slide-bg {
        position: absolute;
        inset: 0;
        background: linear-gradient(to right, #feb82b, #2387ff, #e561a1);
        z-index: 0;
    }

    .carousel-slide img {
        position: relative;
        z-index: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: center;
    }

    .carousel-gradient-overlay {
        position: absolute;
        left: 0;
        right: 0;
        bottom: 0;
        height: 12rem;
        background: linear-gradient(to top, rgba(0, 0, 0, 0.2), transparent);
        z-index: 10;
    }

    .carousel-content {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        z-index: 20;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 1rem;
        width: 90%;
    }

    .carousel-heading {
        color: white;
        font-size: 1.5rem;
        font-weight: 700;
        text-align: center;
        text-shadow: 0 0 8px black;
        margin: 0;
    }

    @media (min-width: 768px) {
        .carousel-heading {
            font-size: 2.25rem;
        }
    }

    .carousel-btn {
        background: white;
        color: black;
        padding: 0.5rem 1.5rem;
        border-radius: 0.375rem;
        font-weight: 600;
        box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.15);
        text-decoration: none;
        transition: transform 0.3s ease, background-color 0.3s ease;
        display: inline-block;
    }

    .carousel-btn:hover {
        background: #e5e5e5;
        transform: scale(1.05);
    }

    .carousel-arrow {
        position: absolute;
        top: 50%;
        transform: translateY(-50%);
        background: rgba(0, 0, 0, 0.5);
        color: white;
        padding: 0.75rem;
        border-radius: 9999px;
        border: none;
        cursor: pointer;
        z-index: 30;
        font-size: 1rem;
        line-height: 1;
    }

    .carousel-arrow:hover {
        background: rgba(0, 0, 0, 0.7);
    }

    .carousel-arrow-left {
        left: 1rem;
    }

    .carousel-arrow-right {
        right: 1rem;
    }

    .carousel-dots {
        position: absolute;
        bottom: 1rem;
        left: 50%;
        transform: translateX(-50%);
        display: flex;
        gap: 0.5rem;
        z-index: 30;
    }

    .carousel-dot {
        width: 0.75rem;
        height: 0.75rem;
        border-radius: 9999px;
        border: none;
        cursor: pointer;
        background: #9ca3af;
        padding: 0;
    }

    .carousel-dot.active {
        background: white;
    }

    /* Fade transition classes used by Alpine's x-transition */
    .fade-enter {
        transition: opacity 0.7s ease-out;
    }

    .fade-enter-start {
        opacity: 0;
    }

    .fade-enter-end {
        opacity: 1;
    }

    .fade-leave {
        transition: opacity 0.7s ease-in;
    }

    .fade-leave-start {
        opacity: 1;
    }

    .fade-leave-end {
        opacity: 0;
    }
</style>

<!-- Header Carousel -->
<div class="header-carousel" x-data="{ current: 0, slides: 4 }"
    x-init="setInterval(() => { current = (current < slides - 1 ? current + 1 : 0) }, 5000)">

    <!-- Slides container -->
    <div class="carousel-slides">

        <!-- Slide 1 -->
        <div x-show="current === 0" x-transition:enter="fade-enter" x-transition:enter-start="fade-enter-start"
            x-transition:enter-end="fade-enter-end" x-transition:leave="fade-leave"
            x-transition:leave-start="fade-leave-start" x-transition:leave-end="fade-leave-end" class="carousel-slide">

            <div class="carousel-slide-bg"></div>
            <img src="{{ 'strawberry-charm-drop.jpeg' | asset_url }}" alt="Slide 1">
            <div class="carousel-gradient-overlay"></div>

            <div class="carousel-content">
                {% comment %} <h2 class="carousel-heading">
                    Handcrafted & Hand-Stitched (no sewing machine!)
                </h2> {% endcomment %}
                <a href="https://arielcameronleather.com/collections/crossbody-collection" class="carousel-btn">
                    Shop Charm Collection
                </a>
            </div>
        </div>

        <!-- Slide 2 -->
        <div x-show="current === 1" x-transition:enter="fade-enter" x-transition:enter-start="fade-enter-start"
            x-transition:enter-end="fade-enter-end" x-transition:leave="fade-leave"
            x-transition:leave-start="fade-leave-start" x-transition:leave-end="fade-leave-end" class="carousel-slide">

            <div class="carousel-slide-bg"></div>
            <img src="{{ 'bread-drop.jpg' | asset_url }}" alt="Slide 2">
            <div class="carousel-gradient-overlay"></div>

            <div class="carousel-content">
                {% comment %} <h2 class="carousel-heading">
                    You had me at Polka Dots!
                </h2> {% endcomment %}
                <a href="https://arielcameronleather.com/collections/crossbody-collection" class="carousel-btn">
                    Shop Charm Collection
                </a>
            </div>
        </div>

        <!-- Slide 3 -->
        <div x-show="current === 2" x-transition:enter="fade-enter" x-transition:enter-start="fade-enter-start"
            x-transition:enter-end="fade-enter-end" x-transition:leave="fade-leave"
            x-transition:leave-start="fade-leave-start" x-transition:leave-end="fade-leave-end" class="carousel-slide">

            <div class="carousel-slide-bg"></div>
            <img src="{{ 'butter-wallet-drop.jpeg' | asset_url }}" alt="Slide 3">
            <div class="carousel-gradient-overlay"></div>

            <div class="carousel-content">
                {% comment %} <h2 class="carousel-heading">
                    One of One Original Designs!
                </h2> {% endcomment %}
                <a href="https://arielcameronleather.com/collections/crossbody-collection" class="carousel-btn">
                    Shop Charm Collection
                </a>
            </div>
        </div>

        <!-- Slide 4 -->
        <div x-show="current === 3" x-transition:enter="fade-enter" x-transition:enter-start="fade-enter-start"
            x-transition:enter-end="fade-enter-end" x-transition:leave="fade-leave"
            x-transition:leave-start="fade-leave-start" x-transition:leave-end="fade-leave-end" class="carousel-slide">

            <div class="carousel-slide-bg"></div>
            <img src="{{ 'butter-charm-drop.jpeg' | asset_url }}" alt="Slide 4">
            <div class="carousel-gradient-overlay"></div>

            <div class="carousel-content">
                {% comment %} <h2 class="carousel-heading">
                    One of One Original Designs!
                </h2> {% endcomment %}
                <a href="https://arielcameronleather.com/collections/crossbody-collection" class="carousel-btn">
                    Shop Charm Collection
                </a>
            </div>
        </div>

    </div>

    <!-- Navigation Arrows -->
    <button @click="current = (current > 0 ? current - 1 : slides - 1)" class="carousel-arrow carousel-arrow-left">
        &#10094;
    </button>
    <button @click="current = (current < slides - 1 ? current + 1 : 0)" class="carousel-arrow carousel-arrow-right">
        &#10095;
    </button>

    <!-- Dots -->
    <div class="carousel-dots">
        <button @click="current = 0" :class="{ active: current === 0 }" class="carousel-dot"></button>
        <button @click="current = 1" :class="{ active: current === 1 }" class="carousel-dot"></button>
        <button @click="current = 2" :class="{ active: current === 2 }" class="carousel-dot"></button>
        <button @click="current = 3" :class="{ active: current === 3 }" class="carousel-dot"></button>
    </div>

</div>