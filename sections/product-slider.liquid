<style>
    /* FULL WIDTH FIX */
 .hero-banner {
    position: relative;
    width: 100vw;
    margin-left: calc(-50vw + 50%);
    overflow: hidden;
    height: 1250px;
}

.hero-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: bottom;

}

    /* OVERLAY */
.hero-overlay {
    position: absolute;
    top: 50%;
    left: 80px;
    transform: translateY(-50%);
}

    /* TEXT IMAGE STACK */
    .hero-text-images {
        display: flex;
        flex-direction: column;
        gap: 5px;
        margin-bottom: 15px;
    }

    /* TEXT IMAGES */
    .hero-text-images img {
        width: 500px;
        /* control text size */
        max-width: 100%;
    }

    /* BUTTON */
    .hero-btn {
        display: inline-block;
        padding: 12px 26px;
        background: white;
        color: black;
        text-decoration: none;
        font-size: 14px;
        font-weight: 600;
        letter-spacing: 1px;
        transition: all 0.3s ease;
    }

    /* HOVER */
    .hero-btn:hover {
        background: black;
        color: white;
    }

    /* OPTIONAL DARK FADE */
    .hero-banner::after {
        content: "";
        position: absolute;
        bottom: 0;
        left: 0;
        right: 0;
        height: 40%;
    }

.hero-image {
    width: 100%;
    height: auto;
    display: block;
}
</style>

<div class="hero-banner">
    <img src="{{ 'acl_ceo_strawberry_img.jpeg' | asset_url }}" alt="Strawberry Bag" class="hero-image">

    <div class="hero-overlay">
        <div class="hero-text-images">
            <img src="{{ 'New Strawberry Collection Verbiage.png' | asset_url }}" alt="Strawberry verbiage">
        </div>

        <a href="/collections/strawberry-product-drop" class="hero-btn">Shop Now</a>
    </div>
</div>